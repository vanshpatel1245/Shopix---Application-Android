<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/admin_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Image placeholder -->
        <FrameLayout android:layout_width="70dp" android:layout_height="70dp"
            android:background="@color/admin_surface">
            <TextView android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="📦" android:textSize="28sp" android:gravity="center" />
            <ImageView android:id="@+id/imgProduct"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <!-- Info -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginStart="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/txtName"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textColor="@color/admin_text_primary"
                    android:textSize="14sp" android:textStyle="bold"
                    android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/txtStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✅ Approved"
                    android:textColor="@color/admin_success"
                    android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>

            <TextView android:id="@+id/txtCategory"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="@color/admin_info" android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:id="@+id/txtPrice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="₹0"
                    android:textColor="@color/admin_accent"
                    android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtOldPrice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text=" ₹0"
                    android:textColor="@color/admin_text_muted"
                    android:textSize="12sp" android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="2dp">
                <TextView android:id="@+id/txtSku"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SKU: xxx"
                    android:textColor="@color/admin_text_muted" android:textSize="11sp" />
                <TextView android:id="@+id/txtStock"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="  |  Stock: 0"
                    android:textColor="@color/admin_text_muted" android:textSize="11sp" />
            </LinearLayout>

            <TextView android:id="@+id/txtSeller"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Seller: xxx"
                android:textColor="@color/admin_text_secondary" android:textSize="11sp"
                android:layout_marginTop="2dp" />

            <!-- Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAction"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:text="Approve"
                android:textAllCaps="false" android:textColor="@color/admin_white"
                android:textSize="12sp"
                android:backgroundTint="@color/admin_success"
                app:cornerRadius="8dp" android:layout_marginTop="8dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>