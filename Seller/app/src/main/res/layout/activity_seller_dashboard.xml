<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ═══════ MAIN CONTENT ═══════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shopix_bg_default">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@color/shopix_white"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSellerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Seller Name"
                    android:textColor="@color/shopix_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Here's your business overview"
                    android:textColor="@color/shopix_gray_500"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_primary"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_category"
                    app:tint="@color/shopix_white" />
            </FrameLayout>

        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_search"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Search products, SKU..."
                        android:textSize="14sp"
                        android:textColor="@color/shopix_dark" />

                    <ImageView
                        android:id="@+id/btnSearch"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/shopix_gray_500" />
                </LinearLayout>

                <!-- Stats Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardProducts"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/shopix_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="PRODUCTS" android:textColor="@color/shopix_gray_500" android:textSize="11sp" />
                            <TextView android:id="@+id/txtProducts"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="000" android:textColor="@color/shopix_primary"
                                android:textSize="22sp" android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardTotalOrders"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/shopix_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="TOTAL ORDERS" android:textColor="@color/shopix_gray_500" android:textSize="11sp" />
                            <TextView android:id="@+id/txtTotalOrders"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="000" android:textColor="@color/shopix_primary"
                                android:textSize="22sp" android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Stats Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPending"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/shopix_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="PENDING" android:textColor="@color/shopix_gray_500" android:textSize="11sp" />
                            <TextView android:id="@+id/txtPending"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="000" android:textColor="@color/shopix_warning"
                                android:textSize="22sp" android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardDelivered"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/shopix_white"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">
                        <LinearLayout android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="DELIVERED" android:textColor="@color/shopix_gray_500" android:textSize="11sp" />
                            <TextView android:id="@+id/txtDelivered"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="000" android:textColor="@color/shopix_success"
                                android:textSize="22sp" android:textStyle="bold"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Total Income Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/shopix_primary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center" android:orientation="vertical"
                        android:paddingTop="20dp" android:paddingBottom="20dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="TOTAL INCOME (AFTER FEES)" android:textColor="#CCFFFFFF" android:textSize="12sp" />
                        <TextView android:id="@+id/txtTotalIncome"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginTop="6dp" android:text="₹00000.00"
                            android:textColor="@color/shopix_white" android:textSize="28sp" android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Your Products Header -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your Products"
                    android:textColor="@color/shopix_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Products RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading Spinner -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminateTint="@color/shopix_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ═══════ NAVIGATION DRAWER ═══════ -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="270dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/shopix_white"
        android:elevation="16dp">

        <!-- Drawer Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/shopix_primary"
            android:paddingTop="44dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/logo_shopix_light"
                    android:layout_marginBottom="12dp"
                    android:layout_marginStart="24dp" />

                <TextView
                    android:id="@+id/txtNavStoreName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopix"
                    android:textColor="@color/shopix_white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="24dp" />

                <TextView
                    android:id="@+id/txtNavEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seller Portal"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginStart="24dp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnCloseDrawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="-8dp"
                android:background="@drawable/bg_button_translucent"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_close"
                    app:tint="@color/shopix_white" />
            </FrameLayout>

        </RelativeLayout>

        <!-- Nav Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <TextView android:id="@+id/tvNavDashboard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Dashboard"
                android:textColor="@color/shopix_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground" />

            <TextView android:id="@+id/tvNavAddProduct"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Add New Products"
                android:textColor="@color/shopix_dark"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground" />

            <TextView android:id="@+id/tvNavOrders"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Orders"
                android:textColor="@color/shopix_dark"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground" />

            <TextView android:id="@+id/tvNavProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Profile"
                android:textColor="@color/shopix_dark"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:paddingEnd="16dp"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

        <!-- Divider + Logout pinned to bottom -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/shopix_gray_100" />

        <TextView android:id="@+id/tvNavLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Logout"
            android:textColor="@color/shopix_error"
            android:textSize="14sp"
            android:gravity="center_vertical"
            android:layout_marginStart="24dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>