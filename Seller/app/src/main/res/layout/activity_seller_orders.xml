<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shopix_bg_default"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@color/shopix_white"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_back" />
        </FrameLayout>

        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Orders"
            android:textColor="@color/shopix_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/shopix_white"
        app:layout_constraintTop_toBottomOf="@id/header">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/bg_search"
            android:hint="Search by Order ID or Product..."
            android:paddingStart="12dp"
            android:textSize="14sp"
            android:textColor="@color/shopix_dark" />
    </LinearLayout>

    <!-- Filter Tabs -->
    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/shopix_white"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/searchContainer">

        <TextView android:id="@+id/tabAll"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="All"
            android:gravity="center" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/shopix_primary" />

        <TextView android:id="@+id/tabPending"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Pending"
            android:gravity="center" android:textSize="13sp"
            android:textColor="@color/shopix_gray_500" />

        <TextView android:id="@+id/tabCompleted"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Completed"
            android:gravity="center" android:textSize="13sp"
            android:textColor="@color/shopix_gray_500" />

        <TextView android:id="@+id/tabRejected"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Rejected"
            android:gravity="center" android:textSize="13sp"
            android:textColor="@color/shopix_gray_500" />

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
