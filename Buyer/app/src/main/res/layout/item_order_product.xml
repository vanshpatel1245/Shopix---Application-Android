<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Product image placeholder -->
    <ImageView
        android:id="@+id/imgProduct"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@color/shopix_gray_100"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/txtName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Name"
            android:textColor="@color/shopix_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹999.00"
            android:textColor="@color/shopix_primary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/txtQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Qty: 1"
                android:textColor="@color/shopix_gray_500"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtSellerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  Seller ID: 00"
                android:textColor="@color/shopix_gray_500"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>