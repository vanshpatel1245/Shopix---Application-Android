<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shopix_bg_default">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ✅ Professional Success Image -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_order_success"
            android:contentDescription="Order successful"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Placed Successfully!"
            android:textColor="@color/shopix_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thank you for shopping with Shopix"
            android:textColor="@color/shopix_gray_500"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Info Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/shopix_white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Total Paid -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Total Paid"
                        android:textColor="@color/shopix_gray_500" android:textSize="13sp" />
                    <TextView android:id="@+id/txtTotal"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="₹000.00"
                        android:textColor="@color/shopix_primary"
                        android:textSize="15sp" android:textStyle="bold" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="@color/shopix_gray_100" android:layout_marginBottom="12dp" />

                <!-- Order ID -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Order ID"
                        android:textColor="@color/shopix_gray_500" android:textSize="13sp" />
                    <TextView android:id="@+id/txtOrderId"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="#00"
                        android:textColor="@color/shopix_dark"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Payment ID -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Payment ID"
                        android:textColor="@color/shopix_gray_500" android:textSize="13sp" />
                    <TextView android:id="@+id/txtPaymentId"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="pay_xxx"
                        android:textColor="@color/shopix_success"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Status -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Status"
                        android:textColor="@color/shopix_gray_500" android:textSize="13sp" />
                    <TextView android:id="@+id/txtStatus"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Paid"
                        android:textColor="@color/shopix_success"
                        android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <!-- Placed At -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Placed On"
                        android:textColor="@color/shopix_gray_500" android:textSize="13sp" />
                    <TextView android:id="@+id/txtPlacedAt"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/shopix_dark" android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/btnRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewOrders"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="My Orders"
            android:textAllCaps="false"
            android:textColor="@color/shopix_primary"
            android:backgroundTint="@color/shopix_white"
            app:strokeColor="@color/shopix_primary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Continue Shopping"
            android:textAllCaps="false"
            android:textColor="@color/shopix_white"
            android:backgroundTint="@color/shopix_primary"
            app:cornerRadius="14dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>