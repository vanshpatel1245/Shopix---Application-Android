<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/shopix_bg_default">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Image Section -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/shopix_gray_100" />

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/ic_heart"
                    android:elevation="4dp"
                    app:tint="@color/shopix_primary" />
            </FrameLayout>

            <!-- Product Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/txtProductName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Product Name"
                    android:textColor="@color/shopix_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Price and Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0000.00"
                        android:textColor="@color/shopix_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtOldPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0000.00"
                        android:textColor="@color/shopix_gray_500"
                        android:textSize="14sp"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/txtStockStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="In Stock"
                        android:textColor="@color/shopix_primary"
                        android:textSize="12sp"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <!-- Description -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown..."
                        android:textColor="@color/shopix_gray_500"
                        android:textSize="14sp"
                        android:lineSpacingExtra="4dp"
                        android:maxLines="3"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/txtMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="more"
                        android:textColor="@color/shopix_primary"
                        android:textStyle="bold"
                        android:layout_alignBottom="@id/txtDescription"
                        android:layout_alignParentEnd="true"
                        android:background="@color/shopix_bg_default"
                        android:paddingStart="4dp" />
                </RelativeLayout>

                <!-- Quantity Selector -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_chip_light"
                    android:backgroundTint="@color/shopix_white"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:elevation="0dp">

                    <ImageView
                        android:id="@+id/btnMinus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_minus"
                        android:padding="12dp"
                        app:tint="@color/shopix_primary" />

                    <TextView
                        android:id="@+id/txtQty"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textAlignment="center"
                        android:textColor="@color/shopix_dark"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <ImageView
                        android:id="@+id/btnPlus"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_plus"
                        android:padding="12dp"
                        app:tint="@color/shopix_primary" />

                </LinearLayout>

                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddToCart"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Add to cart"
                        android:textAllCaps="false"
                        android:textColor="@color/shopix_dark"
                        android:backgroundTint="@color/shopix_white"
                        app:cornerRadius="12dp"
                        app:strokeColor="@color/shopix_primary"
                        app:strokeWidth="1dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBuyNow"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="Buy Now"
                        android:textAllCaps="false"
                        android:textColor="@color/shopix_white"
                        android:backgroundTint="@color/shopix_primary"
                        app:cornerRadius="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

                <!-- Info Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:layout_marginTop="24dp"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <!-- Category -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_chip_light"
                        android:backgroundTint="@color/shopix_white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category"
                            android:textColor="@color/shopix_dark"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Category Name"
                            android:textColor="@color/shopix_gray_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- GST No -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_chip_light"
                        android:backgroundTint="@color/shopix_white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GST No."
                            android:textColor="@color/shopix_dark"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtGst"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Loading..."
                            android:textColor="@color/shopix_gray_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Available -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_chip_light"
                        android:backgroundTint="@color/shopix_white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Available"
                            android:textColor="@color/shopix_dark"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtStock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00 pcs"
                            android:textColor="@color/shopix_gray_500"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Seller ID -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_chip_light"
                        android:backgroundTint="@color/shopix_white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Seller ID"
                            android:textColor="@color/shopix_dark"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/txtSellerId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Loading..."
                                android:textColor="@color/shopix_gray_500"
                                android:textSize="11sp" />

                            <ImageView
                                android:id="@+id/imgVerified"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_verified"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                </GridLayout>

                <!-- Recommended Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="You Might Also Like"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/shopix_dark"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRecommended"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:listitem="@layout/item_product" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/shopix_white"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />

</RelativeLayout>
